# DigitalOcean Serverless Inference API endpoint.
INFERENCE_ENDPOINT=https://inference.do-ai.run/v1/chat/completions

# DigitalOcean model access key.
MODEL_ACCESS_KEY=

# Maximum number of prompts processed concurrently.
MAX_WORKERS=5

# Maximum retries after an inference request fails.
MAX_RETRIES=3

# Initial delay between retries, in seconds.
BASE_BACKOFF_SECONDS=0.01
